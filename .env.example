# Copy to .env  (never commit .env)
DATABASE_URL=sqlite:///./trustvault.db
# Production example: postgresql+psycopg2://user:pass@host:5432/trustvault
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
SESSION_TTL_MINUTES=60
SECRET_KEY=change-me-to-a-long-random-string
# Set COOKIE_SECURE=true when served over HTTPS
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:8000

# ---- First administrator (REQUIRED to be able to sign in as admin) ----
# Created at startup if no user with this email exists. Use a strong password (10+ characters).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password-here
ADMIN_NAME=Administrator
# More emails allowed into the Administrator portal with Google (comma separated)
# ADMIN_EMAILS=colleague@example.com

# ---- Continue with Google (optional) ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorised JavaScript origins: http://localhost:8000 and your deployed https URL
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# ---- Owner uploads must be approved by an administrator before anyone else can see them ----
REQUIRE_DOCUMENT_APPROVAL=true

# ---- Email notifications (optional): new sign-ups to admins, decisions to users ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=TrustVault <you@gmail.com>

# ---- Optional AI re-ranking of sharing suggestions (off by default; rules only) ----
AI_PROVIDER=rules
# ANTHROPIC_API_KEY=
